# Public site URL (canonical URLs, sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=https://pourdecisions.nl

# Contentful (leave empty to serve the local fixtures in content/fixtures)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
# Draft content: set both to read from the Preview API instead of Delivery
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_USE_PREVIEW=false
