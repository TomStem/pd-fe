n        :key=\"distillery.slug\"\n      >\n        <NuxtLink\n          :to=\"`/distilleries/${distillery.slug}`\"\n          :class=\"{ 'text-sherry hover:underline': unavailable }\"\n        >\n          {{ [distillery.name, distillery.town].filter(Boolean).join(', ') }}\n        </NuxtLink>\n      </li>\n    </ul>\n  </div>\n</template>\n"],"version":3}