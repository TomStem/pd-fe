>\n        <span v-if=\"whisky.averageRating !== undefined\"><span\n          class=\"text-sherry\"\n          aria-hidden=\"true\"\n        >★</span> {{ formatRating(whisky.averageRating) }}<span class=\"sr-only\"> van 5</span></span>\n      </p>\n    </div>\n  </article>\n</template>\n"],"version":3}