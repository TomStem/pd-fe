,SAAAG,SAKY,GAAA,OAAA,SAAA,aAAA;;U,QAFXC,gBAAA,uCAED,C;;;;GAGqB,MAAA,yDAAAF,eAAAD,MAAA,OAAA,CAAO,CAAC,IAAI,EAAA,MAAA;GAEjB,IAAAA,MAAA,IAAA,CAAI,CAAC,aAAa,QAAM;;;KAEnC,cAAcA,MAAA,IAAA,CAAI,CAAC;KACpB,OAAM;;;IAIiB,gBAAAA,MAAA,IAAA,CAAI,CAAC,eAAnB,eAAU;;MAChB,KAAK,WAAW;MACJ;;;;G,OAMjB,MAAAD,mBAAA,sBAAA,EAAA,OAAM,OAAM,GAAA;IAFd,SAAAG,SAKY,GAAA,OAAA,SAAA,aAAA;;U,QAFXC,gBAAA,qCAED,C","names":["_ssrRenderAttrs","_mergeProps","_withCtx","_ssrInterpolate","_createTextVNode","_toDisplayString","_withAsyncContext","_ssrRenderAttrs","_mergeProps","_ssrRenderComponent","_unref","_ssrInterpolate","_withCtx","_createTextVNode"],"sources":["../../../../../../../app/components/RegionCard.vue","../../../../../../../app/pages/landen/[country]/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\ndefineProps<{ region: RegionView }>();\n</script>\n\n<template>\n  <article class=\"card flex h-full flex-col\">\n    <CoverImage\n      :src=\"region.image\"\n      :alt=\"region.name\"\n      :slugs=\"[region.slug, region.country.slug]\"\n      :tag=\"`${region.distilleryCount} ${region.distilleryCount === 1 ? 'distillerie' : 'distilleries'}`\"\n    />\n    <div class=\"flex flex-1 flex-col p-4\">\n      <h3 class=\"text-lg font-bold\">\n        <NuxtLink\n          :to=\"`/landen/${region.country.slug}/${region.slug}`\"\n          class=\"stretched-link\"\n        >\n          {{ region.name }}\n        </NuxtLink>\n      </h3>\n      <p\n        v-if=\"region.summary\"\n        class=\"mt-1 text-sm text-smoke\"\n      >\n        {{ region.summary }}\n      </p>\n      <p\n        v-if=\"region.flavourProfile.length\"\n        class=\"mt-auto flex flex-wrap gap-1.5 pt-3\"\n      >\n        <span\n          v-for=\"flavour in region.flavourProfile\"\n          :key=\"flavour\"\n          class=\"dram\"\n        >{{ flavour }}</span>\n      </p>\n    </div>\n  </article>\n</template>\n","<script setup lang=\"ts\">\nconst route = useRoute();\nconst data = await useContentFetch<CountryDetail>(`/api/countries/${route.params.country}`);\nconst country = computed(() => data.value.country);\n\nconst crumbs = computed(() => [{ label: 'Landen', to: '/landen' }, { label: country.value.name }]);\n\nusePageSeo({\n  title: country.value.name,\n  description: country.value.summary,\n  image: country.value.image,\n  seo: country.value,\n});\n</script>\n\n<template>\n  <div class=\"container-page py-8 lg:py-12\">\n    <Breadcrumbs :items=\"crumbs\" />\n    <h1 class=\"mt-6 text-4xl font-bold\">\n      <span\n        v-if=\"country.flag\"\n        aria-hidden=\"true\"\n      >{{ country.flag }}</span> {{ country.name }}\n    </h1>\n    <p\n      v-if=\"country.summary\"\n      class=\"mt-3 max-w-prose text-lg text-smoke\"\n    >\n      {{ country.summary }}\n    </p>\n    <RichText\n      v-if=\"country.intro\"\n      :html=\"country.intro\"\n      class=\"mt-6\"\n    />\n    <EmptyNote\n      v-else\n      class=\"mt-6\"\n    >\n      Nog geen beschrijving beschikbaar.\n    </EmptyNote>\n\n    <h2 class=\"mt-12 text-2xl font-bold\">\n      Regio's\n    </h2>\n    <div\n      v-if=\"data.regions.length\"\n      class=\"mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"\n    >\n      <RegionCard\n        v-for=\"region in data.regions\"\n        :key=\"region.slug\"\n        :region=\"region\"\n      />\n    </div>\n    <EmptyNote\n      v-else\n      class=\"mt-3\"\n    >\n      Nog geen regio's toegevoegd.\n    </EmptyNote>\n\n    <h2 class=\"mt-12 text-2xl font-bold\">\n      Proeverijen over {{ country.name }}\n    </h2>\n    <div\n      v-if=\"data.tastings.length\"\n      class=\"mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"\n    >\n      <TastingCard\n        v-for=\"tasting in data.tastings\"\n        :key=\"tasting.slug\"\n        :tasting=\"tasting\"\n      />\n    </div>\n    <EmptyNote\n      v-else\n      class=\"mt-3\"\n    >\n      Nog geen proeverijen over dit land.\n    </EmptyNote>\n\n    <h2 class=\"mt-12 text-2xl font-bold\">\n      Distilleries in {{ country.name }}\n    </h2>\n    <template v-if=\"data.distilleries.length\">\n      <DistilleryMap\n        :distilleries=\"data.distilleries\"\n        class=\"mt-4\"\n      />\n      <div class=\"mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        <DistilleryCard\n          v-for=\"distillery in data.distilleries\"\n          :key=\"distillery.slug\"\n          :distillery=\"distillery\"\n        />\n      </div>\n    </template>\n    <EmptyNote\n      v-else\n      class=\"mt-3\"\n    >\n      Nog geen distilleries toegevoegd.\n    </EmptyNote>\n  </div>\n</template>\n"],"version":3}