> [distillery.value]);\n\nconst crumbs = computed(() => [\n  { label: 'Distilleries', to: '/distilleries' },\n  { label: country.value.name, to: `/landen/${country.value.slug}` },\n  ...(region.value ? [{ label: region.value.name, to: `/landen/${country.value.slug}/${region.value.slug}` }] : []),\n  { label: distillery.value.name },\n]);\n\nusePageSeo({\n  title: distillery.value.name,\n  description: distillery.value.summary,\n  seo: distillery.value,\n});\n</script>\n\n<template>\n  <div class=\"container-page grid gap-8 py-8 lg:grid-cols-[1.4fr_1fr] lg:py-12\">\n    <div>\n      <Breadcrumbs :items=\"crumbs\" />\n      <h1 class=\"mt-6 text-4xl font-bold\">\n        {{ distillery.name }}\n      </h1>\n      <p\n        v-if=\"distillery.summary\"\n        class=\"mt-3 text-lg text-smoke\"\n      >\n        {{ distillery.summary }}\n      </p>\n      <RichText\n        v-if=\"distillery.story\"\n        :html=\"distillery.story\"\n        class=\"mt-6\"\n      />\n      <EmptyNote\n        v-else\n        class=\"mt-6\"\n      >\n        Nog geen beschrijving beschikbaar.\n      </EmptyNote>\n\n      <NuxtImg\n        v-if=\"distillery.image\"\n        :src=\"distillery.image\"\n        :alt=\"`Foto van ${distillery.name}`\"\n        width=\"800\"\n        height=\"600\"\n        loading=\"lazy\"\n        class=\"mt-8 rounded-card\"\n      />\n\n      <section\n        class=\"mt-10\"\n        aria-labelledby=\"whiskies-heading\"\n      >\n        <h2\n          id=\"whiskies-heading\"\n          class=\"text-2xl font-bold\"\n        >\n          Whisky's van {{ distillery.name }}\n        </h2>\n        <div\n          v-if=\"data.whiskies.length\"\n          class=\"mt-4 grid gap-4 sm:grid-cols-2\"\n        >\n          <WhiskyCard\n            v-for=\"whisky in data.whiskies\"\n            :key=\"whisky.slug\"\n            :whisky=\"whisky\"\n          />\n        </div>\n        <EmptyNote\n          v-else\n          class=\"mt-3\"\n        >\n          Nog geen whisky's van deze distilleerderij.\n        </EmptyNote>\n      </section>\n\n      <section\n        class=\"mt-10\"\n        aria-labelledby=\"tastings-heading\"\n      >\n        <h2\n          id=\"tastings-heading\"\n          class=\"text-2xl font-bold\"\n        >\n          Proeverijen met {{ distillery.name }}\n        </h2>\n        <div\n          v-if=\"data.tastings.length\"\n          class=\"mt-4 grid gap-4 sm:grid-cols-2\"\n        >\n          <TastingCard\n            v-for=\"tasting in data.tastings\"\n            :key=\"tasting.slug\"\n            :tasting=\"tasting\"\n          />\n        </div>\n        <EmptyNote\n          v-else\n          class=\"mt-3\"\n        >\n          Nog geen proeverijen met deze distilleerderij.\n        </EmptyNote>\n      </section>\n\n      <section\n        class=\"mt-10\"\n        aria-labelledby=\"trips-heading\"\n      >\n        <h2\n          id=\"trips-heading\"\n          class=\"text-2xl font-bold\"\n        >\n          Reizen langs {{ distillery.name }}\n        </h2>\n        <div\n          v-if=\"data.trips.length\"\n          class=\"mt-4 grid gap-4 sm:grid-cols-2\"\n        >\n          <TripCard\n            v-for=\"trip in data.trips\"\n            :key=\"trip.slug\"\n            :trip=\"trip\"\n          />\n        </div>\n        <EmptyNote\n          v-else\n          class=\"mt-3\"\n        >\n          Nog geen reizen langs deze distilleerderij.\n        </EmptyNote>\n      </section>\n    </div>\n\n    <aside class=\"h-fit space-y-5\">\n      <div class=\"rounded-card border border-line bg-paper p-5\">\n        <dl class=\"grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm\">\n          <dt class=\"text-smoke\">\n            {{ region ? 'Regio' : 'Land' }}\n          </dt>\n          <dd>\n            <NuxtLink\n              :to=\"region ? `/landen/${country.slug}/${region.slug}` : `/landen/${country.slug}`\"\n              class=\"text-sherry hover:underline\"\n            >\n              {{ region ? `${region.name}, ${country.name}` : country.name }}\n            </NuxtLink>\n          </dd>\n          <dt class=\"text-smoke\">\n            Plaats\n          </dt>\n          <dd>\n            <template v-if=\"distillery.town\">\n              {{ distillery.town }}\n            </template>\n            <EmptyNote v-else>\n              Onbekend\n            </EmptyNote>\n          </dd>\n          <dt class=\"text-smoke\">\n            Opgericht\n          </dt>\n          <dd>\n            <span\n              v-if=\"distillery.founded\"\n              class=\"font-mono\"\n            >{{ distillery.founded }}</span>\n            <EmptyNote v-else>\n              Onbekend\n            </EmptyNote>\n          </dd>\n          <template v-if=\"distillery.visitable !== undefined\">\n            <dt class=\"text-smoke\">\n              Bezoekbaar\n            </dt>\n            <dd>{{ distillery.visitable ? 'Ja' : 'Nee' }}</dd>\n          </template>\n          <dt class=\"text-smoke\">\n            Website\n          </dt>\n          <dd>\n            <a\n              v-if=\"distillery.website\"\n              :href=\"distillery.website\"\n              class=\"break-all text-sherry hover:underline\"\n              target=\"_blank\"\n              rel=\"noopener\"\n            >{{ distillery.website.replace(/^https?:\\/\\/(www\\.)?/, '') }}</a>\n            <EmptyNote v-else>\n              Onbekend\n            </EmptyNote>\n          </dd>\n        </dl>\n      </div>\n      <DistilleryMap\n        v-if=\"distillery.location\"\n        :distilleries=\"single\"\n      />\n      <EmptyNote v-else>\n        Nog geen locatie bekend.\n      </EmptyNote>\n    </aside>\n  </div>\n</template>\n"],"version":3}