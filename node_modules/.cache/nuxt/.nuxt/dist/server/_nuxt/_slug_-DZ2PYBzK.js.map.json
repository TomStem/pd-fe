,CAAM,CAAC,O;IACZ,MAAMA,MAAA,MAAA,CAAM,CAAC;IACd,OAAM;;QAIN,MAAAD,mBAAA,sBAAA,EAAA,OAAM,OAAM,GAAA;IAFd,SAAAE,SAKY,GAAA,OAAA,SAAA,aAAA;;U,QAFXE,gBAAA,uCAED,C;;;;;GAcQ,IAAAH,MAAA,MAAA,CAAM,CAAC,kBAAkB,KAAA,GAAS;;I,kDAG3B,QAAQA,MAAA,MAAA,CAAM,CAAC,c;I,qBAAgCE,eAAAF,MAAA,MAAA,CAAM,CAAC,WAAW,E,GAAOE,eAAAF,MAAA,MAAA,CAAM,CAAC,gBAAW,IAAA,gBAAA,eAAA,E;;GAGjG,IAAAA,MAAA,IAAA,CAAI,CAAC,QAAQ,QAAM;;IAIN,gBAAAA,MAAA,IAAA,CAAI,CAAC,UAAf,WAAM;;K,kDAIA,QAAQ,OAAO,O;KAEvB,MAAA,sCAAAE,eAAA,OAAO,KAAK,EAAA,MAAA;;MAGd,MAAM,OAAO;MACd,OAAM;;;;;G,OAMV,MAAAH,mBAAA,sBAAA,EAAA,OAAM,OAAM,GAAA;IAFd,SAAAE,SAKY,GAAA,OAAA,SAAA,aAAA;;U,QAFXE,gBAAA,qBAED,C;;;;;GAIM,IAAAH,MAAA,IAAA,CAAI,CAAC,SAAS,QAAM;;IAYJ,gBAAAA,MAAA,IAAA,CAAI,CAAC,WAAhB,YAAO;;MACb,KAAK,QAAQ;MACJ;;;;;GAMR,IAAAA,MAAA,IAAA,CAAI,CAAC,SAAS,QAAM;IAQZ,MAAA,4HAAAE,eAAAF,MAAA,UAAA,CAAU,CAAC,IAAI,EAAA,yEAAA;IAIP,gBAAAA,MAAA,IAAA,CAAI,CAAC,WAAhB,YAAO;;MACb,KAAK,QAAQ;MACb,QAAQ","names":["formatRating","_ssrRenderAttrs","_mergeProps","_ssrInterpolate","formatAbv","_withAsyncContext","_ssrRenderAttrs","_mergeProps","_ssrRenderComponent","_unref","_withCtx","_ssrInterpolate","_createTextVNode","_toDisplayString"],"sources":["../../../../../../../app/components/StarRating.vue","../../../../../../../app/pages/whiskys/[slug].vue"],"sourcesContent":["<script setup lang=\"ts\">\ndefineProps<{ rating: number }>();\n</script>\n\n<template>\n  <span class=\"inline-flex text-sherry\">\n    <span aria-hidden=\"true\">{{ '★'.repeat(Math.round(rating)) }}<span class=\"text-line\">{{ '★'.repeat(5 - Math.round(rating)) }}</span></span>\n    <span class=\"sr-only\">{{ formatRating(rating) }} van 5</span>\n  </span>\n</template>\n","<script setup lang=\"ts\">\nconst route = useRoute();\nconst data = await useContentFetch<WhiskyDetail>(`/api/whiskies/${route.params.slug}`);\nconst whisky = computed(() => data.value.whisky);\nconst distillery = computed(() => whisky.value.distillery);\n\nconst crumbs = computed(() => [{ label: 'Whisky\\'s', to: '/whiskys' }, { label: whisky.value.name }]);\nconst place = computed(() => [whisky.value.region?.name, whisky.value.country?.name].filter(Boolean).join(', '));\n\nusePageSeo({\n  title: whisky.value.name,\n  description: `${whisky.value.name} van ${distillery.value.name}.`,\n  image: whisky.value.image,\n  seo: whisky.value,\n});\n</script>\n\n<template>\n  <div class=\"container-page py-8 lg:py-12\">\n    <Breadcrumbs :items=\"crumbs\" />\n    <p class=\"label-mono mt-6 text-sherry\">\n      <NuxtLink\n        :to=\"`/distilleries/${distillery.slug}`\"\n        class=\"hover:underline\"\n      >\n        {{ distillery.name }}\n      </NuxtLink>\n      <template v-if=\"place\">\n        · {{ place }}\n      </template>\n    </p>\n    <h1 class=\"mt-2 text-4xl font-bold\">\n      {{ whisky.name }}\n    </h1>\n    <ul class=\"mt-4 flex flex-wrap gap-2 font-mono text-sm\">\n      <li\n        v-if=\"whisky.isNas\"\n        class=\"pill\"\n      >\n        NAS\n      </li>\n      <li\n        v-else-if=\"whisky.age\"\n        class=\"pill\"\n      >\n        {{ whisky.age }} jaar\n      </li>\n      <li\n        v-else\n        class=\"pill italic text-smoke\"\n      >\n        Leeftijd onbekend\n      </li>\n      <li\n        v-if=\"whisky.abv !== undefined\"\n        class=\"pill\"\n      >\n        {{ formatAbv(whisky.abv) }}\n      </li>\n      <li\n        v-else\n        class=\"pill italic text-smoke\"\n      >\n        ABV onbekend\n      </li>\n    </ul>\n    <ul\n      v-if=\"whisky.casks.length\"\n      class=\"mt-3 flex flex-wrap gap-1.5\"\n      aria-label=\"Vaten\"\n    >\n      <li\n        v-for=\"cask in whisky.casks\"\n        :key=\"cask\"\n        class=\"dram\"\n      >\n        {{ cask }}\n      </li>\n    </ul>\n    <EmptyNote\n      v-else\n      class=\"mt-3 text-sm\"\n    >\n      Vaten onbekend\n    </EmptyNote>\n\n    <CoverImage\n      :src=\"whisky.image\"\n      :alt=\"whisky.name\"\n      :slugs=\"[whisky.region?.slug, whisky.country?.slug]\"\n      height-class=\"h-48\"\n      class=\"mt-6 max-w-md rounded-card\"\n    />\n\n    <section\n      class=\"mt-10\"\n      aria-labelledby=\"notes-heading\"\n    >\n      <h2\n        id=\"notes-heading\"\n        class=\"text-2xl font-bold\"\n      >\n        Proefnotities\n      </h2>\n      <RichText\n        v-if=\"whisky.notes\"\n        :html=\"whisky.notes\"\n        class=\"mt-3\"\n      />\n      <EmptyNote\n        v-else\n        class=\"mt-3\"\n      >\n        Nog geen proefnotities beschikbaar.\n      </EmptyNote>\n    </section>\n\n    <section\n      class=\"mt-10\"\n      aria-labelledby=\"reviews-heading\"\n    >\n      <h2\n        id=\"reviews-heading\"\n        class=\"text-2xl font-bold\"\n      >\n        Beoordelingen\n      </h2>\n      <p\n        v-if=\"whisky.averageRating !== undefined\"\n        class=\"mt-2 text-smoke\"\n      >\n        <StarRating :rating=\"whisky.averageRating\" /> gemiddeld, {{ whisky.reviewCount }} {{ whisky.reviewCount === 1 ? 'beoordeling' : 'beoordelingen' }}\n      </p>\n      <ul\n        v-if=\"data.reviews.length\"\n        class=\"mt-4 grid gap-4 md:grid-cols-2\"\n      >\n        <li\n          v-for=\"review in data.reviews\"\n          :key=\"review.id\"\n          class=\"rounded-card border border-line bg-paper p-5\"\n        >\n          <StarRating :rating=\"review.rating\" />\n          <h3 class=\"mt-1 text-lg font-bold\">\n            {{ review.title }}\n          </h3>\n          <RichText\n            :html=\"review.description\"\n            class=\"mt-2\"\n          />\n        </li>\n      </ul>\n      <EmptyNote\n        v-else\n        class=\"mt-3\"\n      >\n        Nog geen reviews.\n      </EmptyNote>\n    </section>\n\n    <section\n      v-if=\"data.tastings.length\"\n      class=\"mt-12\"\n      aria-labelledby=\"tastings-heading\"\n    >\n      <h2\n        id=\"tastings-heading\"\n        class=\"text-2xl font-bold\"\n      >\n        Geschonken tijdens\n      </h2>\n      <div class=\"mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        <TastingCard\n          v-for=\"tasting in data.tastings\"\n          :key=\"tasting.slug\"\n          :tasting=\"tasting\"\n        />\n      </div>\n    </section>\n\n    <section\n      v-if=\"data.siblings.length\"\n      class=\"mt-12\"\n      aria-labelledby=\"siblings-heading\"\n    >\n      <h2\n        id=\"siblings-heading\"\n        class=\"text-2xl font-bold\"\n      >\n        Meer van {{ distillery.name }}\n      </h2>\n      <div class=\"mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        <WhiskyCard\n          v-for=\"sibling in data.siblings\"\n          :key=\"sibling.slug\"\n          :whisky=\"sibling\"\n        />\n      </div>\n    </section>\n  </div>\n</template>\n"],"version":3}