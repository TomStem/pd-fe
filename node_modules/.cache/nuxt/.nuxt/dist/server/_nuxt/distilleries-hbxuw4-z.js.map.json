,"_ssrLooseEqual","_ssrRenderAttr","_ssrInterpolate","_withCtx","_createTextVNode","_toDisplayString"],"sources":["../../../../../../../app/pages/distilleries/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst distilleries = await useContentFetch<DistilleryView[]>('/api/distilleries');\nusePageSeo({ title: 'Distilleries', description: 'Alle distilleries op de kaart en in de lijst, te filteren op land en regio.' });\n\nconst country = ref('');\nconst region = ref('');\n\nconst countries = computed(() => [...new Map(distilleries.value.map(d => [d.country.slug, d.country])).values()]);\nconst regions = computed(() => [...new Map(\n  distilleries.value\n    .filter(d => d.region && (!country.value || d.country.slug === country.value))\n    .map(d => [d.region!.slug, d.region!]),\n).values()]);\n\nconst filtered = computed(() => distilleries.value.filter(d =>\n  (!country.value || d.country.slug === country.value) && (!region.value || d.region?.slug === region.value),\n));\n\nwatch(country, () => (region.value = ''));\n</script>\n\n<template>\n  <div>\n    <PageHeader\n      title=\"Distilleries\"\n      kicker=\"Ontdekken\"\n      intro=\"Waar de whisky vandaan komt. Filter op land en regio, of pak de kaart erbij.\"\n    />\n\n    <div class=\"container-page pb-14\">\n      <form\n        class=\"mt-4 flex flex-wrap gap-4\"\n        @submit.prevent\n      >\n        <label class=\"flex flex-col gap-1 text-sm font-medium\">\n          Land\n          <select\n            v-model=\"country\"\n            class=\"rounded-full border border-line bg-paper px-4 py-2 text-base font-normal\"\n          >\n            <option value=\"\">Alle landen</option>\n            <option\n              v-for=\"c in countries\"\n              :key=\"c.slug\"\n              :value=\"c.slug\"\n            >{{ c.name }}</option>\n          </select>\n        </label>\n        <label class=\"flex flex-col gap-1 text-sm font-medium\">\n          Regio\n          <select\n            v-model=\"region\"\n            class=\"rounded-full border border-line bg-paper px-4 py-2 text-base font-normal\"\n          >\n            <option value=\"\">Alle regio's</option>\n            <option\n              v-for=\"r in regions\"\n              :key=\"r.slug\"\n              :value=\"r.slug\"\n            >{{ r.name }}</option>\n          </select>\n        </label>\n      </form>\n\n      <p\n        class=\"mt-4 text-sm text-smoke\"\n        aria-live=\"polite\"\n      >\n        {{ filtered.length }} {{ filtered.length === 1 ? 'distillerie' : 'distilleries' }}\n      </p>\n\n      <template v-if=\"filtered.length\">\n        <DistilleryMap\n          :distilleries=\"filtered\"\n          class=\"mt-4\"\n        />\n\n        <div class=\"mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          <DistilleryCard\n            v-for=\"distillery in filtered\"\n            :key=\"distillery.slug\"\n            :distillery=\"distillery\"\n          />\n        </div>\n      </template>\n      <EmptyNote\n        v-else\n        class=\"mt-4\"\n      >\n        {{ distilleries.length ? 'Geen distilleries gevonden voor deze filters.' : 'Nog geen distilleries toegevoegd.' }}\n      </EmptyNote>\n    </div>\n  </div>\n</template>\n"],"version":3}