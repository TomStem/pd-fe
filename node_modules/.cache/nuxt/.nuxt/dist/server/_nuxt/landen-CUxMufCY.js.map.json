props.country.regionCount && `${props.country.regionCount} ${props.country.regionCount === 1 ? 'regio' : 'regio\\'s'}`,\n  props.country.distilleryCount && `${props.country.distilleryCount} ${props.country.distilleryCount === 1 ? 'distillerie' : 'distilleries'}`,\n].filter(Boolean));\n</script>\n\n<template>\n  <article class=\"card flex h-full flex-col\">\n    <CoverImage\n      :src=\"country.image\"\n      :alt=\"country.name\"\n      :slugs=\"[country.slug]\"\n      height-class=\"h-24\"\n    />\n    <div class=\"flex flex-1 flex-col p-4\">\n      <h3 class=\"text-lg font-bold\">\n        <NuxtLink\n          :to=\"`/landen/${country.slug}`\"\n          class=\"stretched-link\"\n        >\n          <span\n            v-if=\"country.flag\"\n            aria-hidden=\"true\"\n          >{{ country.flag }}</span> {{ country.name }}\n        </NuxtLink>\n      </h3>\n      <p\n        v-if=\"country.summary\"\n        class=\"mt-1 text-sm text-smoke\"\n      >\n        {{ country.summary }}\n      </p>\n      <p\n        v-if=\"facts.length\"\n        class=\"mt-auto pt-3 font-mono text-xs text-smoke\"\n      >\n        {{ facts.join(' · ') }}\n      </p>\n    </div>\n  </article>\n</template>\n","<script setup lang=\"ts\">\nconst [countries, distilleries] = await Promise.all([\n  useContentFetch<CountryView[]>('/api/countries'),\n  useContentFetch<DistilleryView[]>('/api/distilleries'),\n]);\nusePageSeo({ title: 'Landen', description: 'Whisky per land, met de regio\\'s en distilleries.' });\n</script>\n\n<template>\n  <div>\n    <PageHeader\n      title=\"Landen\"\n      kicker=\"Ontdekken\"\n      intro=\"Van land naar regio naar distillerie: waar komt jouw dram vandaan?\"\n    />\n    <div class=\"container-page pb-14\">\n      <div\n        v-if=\"countries.length\"\n        class=\"mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"\n      >\n        <CountryCard\n          v-for=\"country in countries\"\n          :key=\"country.slug\"\n          :country=\"country\"\n        />\n      </div>\n      <EmptyNote\n        v-else\n        class=\"mt-4\"\n      >\n        Nog geen landen toegevoegd.\n      </EmptyNote>\n      <h2 class=\"mt-12 text-2xl font-bold\">\n        Alle distilleries op de kaart\n      </h2>\n      <DistilleryMap\n        v-if=\"distilleries.length\"\n        :distilleries=\"distilleries\"\n        class=\"mt-4\"\n      />\n      <EmptyNote\n        v-else\n        class=\"mt-3\"\n      >\n        Nog geen distilleries toegevoegd.\n      </EmptyNote>\n    </div>\n  </div>\n</template>\n"],"version":3}