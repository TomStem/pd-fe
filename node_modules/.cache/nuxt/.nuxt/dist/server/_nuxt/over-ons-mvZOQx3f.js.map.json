{"file":"over-ons-mvZOQx3f.js","mappings":";;;;;;;;;;EACA,WAAW;GAAE,OAAO;GAAY,aAAa;EAAqG,CAAC;;;;;;IAM7I,OAAM;IACN,QAAO;IACP,OAAM;;;;IA4CF,IAAG;IACH,OAAM;;IAFR,SAAAA,SAKW,GAAA,OAAA,SAAA,aAAA;;U,QAFVC,gBAAA,mBAED,C","names":["_withCtx","_createTextVNode"],"sources":["../../../../../../../app/pages/over-ons.vue"],"sourcesContent":["<script setup lang=\"ts\">\nusePageSeo({ title: 'Over ons', description: 'Pour Decisions is een whiskyclub met een knipoog: wij proeven, reizen en discussiëren over whisky.' });\n</script>\n\n<template>\n  <div>\n    <PageHeader\n      title=\"Over ons\"\n      kicker=\"De club\"\n      intro=\"Een beetje grappig, wel serieus over whisky.\"\n    />\n    <div class=\"container-page pb-14\">\n      <div class=\"rich-text mt-4 space-y-4\">\n        <p>\n          Pour Decisions is een whiskyclub voor mensen die graag proeven en nog liever praten over wat ze proeven. Geen snobisme, wel nieuwsgierigheid: we beginnen bij de basis en eindigen bij een discussie die uitloopt.\n        </p>\n        <p>\n          We organiseren proeverijen rond een thema (een regio, een land, een stijl) en gaan een paar keer per jaar op reis naar de plekken waar de whisky vandaan komt. Alles wat we proeven en bezoeken vind je terug op deze site.\n        </p>\n        <p>\n          Dit is voorbeeldtekst: de echte clubgeschiedenis, namen en foto's komen later.\n        </p>\n      </div>\n\n      <div class=\"mt-10 grid gap-4 sm:grid-cols-3\">\n        <div class=\"rounded-card border border-line bg-paper p-5\">\n          <h2 class=\"text-lg font-bold\">\n            Proeverijen\n          </h2>\n          <p class=\"mt-1 text-sm text-smoke\">\n            Thema-avonden met vier tot vijf whisky's, voor beginners en kenners.\n          </p>\n        </div>\n        <div class=\"rounded-card border border-line bg-paper p-5\">\n          <h2 class=\"text-lg font-bold\">\n            Reizen\n          </h2>\n          <p class=\"mt-1 text-sm text-smoke\">\n            Verslagen van onze meerdaagse trips naar distilleries in Schotland, Japan en verder.\n          </p>\n        </div>\n        <div class=\"rounded-card border border-line bg-paper p-5\">\n          <h2 class=\"text-lg font-bold\">\n            Kennis delen\n          </h2>\n          <p class=\"mt-1 text-sm text-smoke\">\n            Landen, regio's, distilleries en flessen: alles met proefnotities op één plek.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"mt-8\">\n        <NuxtLink\n          to=\"/contact\"\n          class=\"btn btn-sherry\"\n        >\n          Neem contact op\n        </NuxtLink>\n      </div>\n    </div>\n  </div>\n</template>\n"],"version":3}