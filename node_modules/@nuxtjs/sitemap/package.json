{
  "name": "@nuxtjs/sitemap",
  "type": "module",
  "version": "9.2.0",
  "description": "Powerfully flexible XML Sitemaps that integrate seamlessly, for Nuxt.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/nuxt-modules/sitemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/sitemap.git"
  },
  "bugs": {
    "url": "https://github.com/nuxt-modules/sitemap/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./content": "./dist/content.mjs",
    "./utils": "./dist/utils.mjs",
    "./content/valibot": {
      "types": "./dist/content-valibot.d.mts",
      "default": "./dist/content-valibot.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ],
      "utils": [
        "./dist/utils.d.mts"
      ],
      "content/valibot": [
        "dist/content-valibot.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0 || ^5.0.0",
    "valibot": "^1.0.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "nuxt-site-config": "^5.0.4",
    "nuxtseo-shared": "^6.0.3",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.11",
    "oxc-parser": "^0.157.0",
    "oxc-walker": "^1.1.1",
    "radix3": "^1.1.2",
    "sitemapd": "^0.2.3",
    "ufo": "^1.6.4",
    "ultrahtml": "^1.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@harlan-zw/comark-content": "^0.2.2",
    "@nuxt/content": "^3.16.2",
    "@nuxt/devtools-kit": "4.0.0-beta.7",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.0",
    "@nuxtjs/sitemap": "9.2.0",
    "@vue/test-utils": "^2.5.1",
    "better-sqlite3": "^13.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-harlanzw": "^0.23.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "nuxt-i18n-micro": "^4.0.0",
    "nuxtseo-layer-devtools": "^6.0.2",
    "std-env": "^4.3.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "valibot": "^1.4.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "build": {
    "externals": [
      "nuxt/server"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "client:build": "node -e \"const { cpSync } = require('fs'); const { sep } = require('path'); cpSync('devtools','dist/devtools',{recursive:true,filter:src=>!src.split(sep).some(p=>['.data','.nuxt','node_modules'].includes(p))})\"",
    "build": "pnpm --filter sitemapd build && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && npm run client:build",
    "dev": "nuxt dev playground",
    "prepare:fixtures": "nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/i18n && nuxt prepare test/fixtures/i18n-micro",
    "dev:build": "nuxt build playground",
    "dev:prepare": "pnpm --filter sitemapd build && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && pnpm run client:build",
    "release": "pnpm build && bumpp -x \"npx changelogen --output=CHANGELOG.md\"",
    "release:sitemapd": "pnpm --filter sitemapd release",
    "test": "pnpm --filter sitemapd test && vitest run && pnpm run test:attw && pnpm run test:nuxt5",
    "test:unit": "vitest --project=unit",
    "test:nuxt5": "pnpm build && pnpm --dir test/fixtures/nuxt5 install --frozen-lockfile && pnpm --dir test/fixtures/nuxt5 test",
    "test:attw": "attw --pack && pnpm --filter sitemapd test:attw",
    "typecheck": "pnpm --filter sitemapd typecheck && nuxt typecheck"
  }
}